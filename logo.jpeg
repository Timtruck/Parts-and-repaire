<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Services - TIM TRUCK Parts and Repairs</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            /* Charte colorielle : Noir, Gris, Jaune Or, Orange */
            --bg-dark: #121212;
            --bg-darker: #080808;
            --card-dark: #1e1e1e;
            --card-gray: #2d2d2d;
            --accent-gold: #FFB800; 
            --accent-orange: #E65C00; 
            --text-light: #f8f9fa;
            --text-gray: #a0a0a0;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Utilitaires couleurs */
        .text-gold { color: var(--accent-gold) !important; }
        .text-orange { color: var(--accent-orange) !important; }
        .text-gray { color: var(--text-gray) !important; }
        .bg-gray { background-color: var(--card-gray) !important; }

        /* Top Bar */
        .top-bar {
            background-color: var(--bg-darker);
            font-size: 0.85rem;
            border-bottom: 1px solid #222;
        }

        /* Navbar */
        .navbar {
            background-color: rgba(18, 18, 18, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 2px solid var(--accent-orange);
        }
        .nav-pills .nav-link {
            color: #ccc;
            border-radius: 20px;
            padding: 6px 18px;
            margin: 0 3px;
            transition: 0.3s;
        }
        .nav-pills .nav-link:hover { color: var(--accent-gold); }
        .nav-pills .nav-link.active {
            background-color: var(--accent-orange);
            color: #fff;
        }
        .btn-call-header {
            background-color: var(--accent-orange);
            color: white;
            font-weight: 700;
            border-radius: 8px;
            transition: 0.3s;
        }
        .btn-call-header:hover { background-color: #cc5200; color: white; }

        /* Hero Services */
        .services-hero {
            background-color: var(--bg-darker);
            padding: 80px 0;
            border-bottom: 1px solid #333;
        }
        .subtitle-hero {
            color: var(--accent-orange);
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        .hero-title {
            font-size: 4rem;
            font-weight: 900;
            text-transform: uppercase;
            line-height: 1;
            margin-bottom: 20px;
        }

        /* What We Do Cards */
        .parts-card {
            background-color: var(--card-dark);
            border: 1px solid #333;
            border-radius: 12px;
            overflow: hidden;
            transition: transform 0.3s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        .parts-card:hover {
            transform: translateY(-5px);
            border-color: var(--accent-gold);
        }
        .parts-card-img-wrapper {
            position: relative;
            height: 200px;
        }
        .parts-card-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .card-icon-badge {
            position: absolute;
            bottom: -20px;
            left: 20px;
            width: 50px;
            height: 50px;
            background-color: var(--accent-orange);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            font-size: 1.5rem;
            border: 3px solid var(--card-dark);
        }
        .parts-card-body {
            padding: 35px 20px 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }
        .ask-link {
            margin-top: auto;
            color: var(--text-light);
            text-decoration: none;
            font-weight: 700;
            font-size: 0.9rem;
            transition: color 0.2s;
        }
        .ask-link:hover { color: var(--accent-gold); }

        /* Feature Bar */
        .feature-bar {
            background-color: var(--bg-darker);
            border-top: 1px solid #333;
            border-bottom: 1px solid #333;
        }
        .feature-icon {
            color: var(--accent-orange);
            font-size: 1.5rem;
        }

        /* Why Us Section */
        .why-card {
            background-color: var(--card-dark);
            border: 1px solid #333;
            border-radius: 12px;
            padding: 30px;
            height: 100%;
            transition: border-color 0.3s;
        }
        .why-card:hover { border-color: var(--accent-orange); }
        .why-number {
            color: var(--accent-orange);
            font-size: 2.5rem;
            font-weight: 900;
            line-height: 1;
        }

        /* Taxes Box */
        .taxes-box {
            border: 2px solid var(--accent-orange);
            background-color: var(--bg-darker);
            border-radius: 12px;
            padding: 40px;
            max-width: 800px;
            margin: 0 auto;
        }

        /* CTA Banner */
        .cta-banner {
            background-color: var(--accent-orange);
            padding: 60px 0;
            color: white;
            text-align: center;
        }
        .btn-cta-group .btn {
            font-weight: bold;
            border-radius: 8px;
            padding: 10px 24px;
        }
        .btn-outline-light-custom {
            border: 2px solid white;
            color: white;
            background: transparent;
        }
        .btn-outline-light-custom:hover {
            background: white;
            color: var(--accent-orange);
        }
        .btn-whatsapp {
            background-color: #25D366;
            color: white;
            border: none;
        }
        .btn-whatsapp:hover { background-color: #1ebc5a; color: white; }

        /* Footer */
        footer {
            background-color: var(--bg-darker);
            border-top: 1px solid #333;
        }
        .floating-chat {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background-color: var(--accent-orange);
            color: white;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            z-index: 1000;
        }
    </style>
</head>
<body>

    <!-- 1. Top Bar (Based on image_c9a626) -->
    <div class="top-bar py-2 d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center text-gray">
            <div class="fw-bold text-light">Text or Call: (865) 685-5944</div>
            <div class="d-flex gap-4">
                <span><i class="fa-solid fa-truck me-2"></i> Ships Nationwide</span>
                <span><i class="fa-solid fa-location-dot me-2"></i> Oak Ridge, TN</span>
            </div>
        </div>
