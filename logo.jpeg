                        </div>
                    </div>
                </div>
                <!-- 03 -->
                <div class="col-12 col-md-6">
                    <div class="why-card d-flex gap-4">
                        <div class="why-number">03</div>
                        <div>
                            <h3 class="h5 fw-bold text-white mb-2">Shipped to your door</h3>
