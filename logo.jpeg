                    <li class="nav-item"><a class="nav-link" href="#">Contact</a></li>
                </ul>
            </div>

            <a href="tel:+18656855944" class="btn btn-call-header px-4 py-2 d-none d-lg-inline-block">
                <i class="fa-solid fa-phone me-2"></i>(865) 685-5944
            </a>
        </div>
    </nav>

    <!-- 3. Hero Section (Based on image_c9a626) -->
    <section class="services-hero">
        <div class="container">
            <div class="row">
                <div class="col-lg-8">
                    <div class="subtitle-hero mb-2">TIM TRUCK PARTS • OAK RIDGE, TN</div>
                    <h1 class="hero-title">What We Do</h1>
                    <p class="lead text-gray mb-4" style="max-width: 600px;">
                        Tailgates, truck beds, toppers, and repairs — done right and shipped nationwide.
