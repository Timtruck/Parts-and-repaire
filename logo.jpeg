                        </div>
                    </div>
                </div>
                <!-- 04 -->
                <div class="col-12 col-md-6">
                    <div class="why-card d-flex gap-4">
                        <div class="why-number">04</div>
                        <div>
                            <h3 class="h5 fw-bold text-white mb-2">Repairs by people who know trucks</h3>
                            <p class="text-gray mb-0">Not just parts — our team fits and repairs, so you can drive away sorted.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Taxes Box -->
            <div class="taxes-box text-center">
